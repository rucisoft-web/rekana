# ---------------------------------------------------------------------------
# Rekana · contoh konfigurasi untuk hosting cPanel (Laravel 13 + MySQL 8)
# Salin menjadi .env lalu sesuaikan. Nilai yang mengandung # atau spasi WAJIB
# diberi tanda kutip, misalnya DB_PASSWORD="sandi#rahasia".
# ---------------------------------------------------------------------------
APP_NAME=Rekana
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://rekana.domainanda.co.id
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Database MySQL 8 (cPanel › MySQL Databases). Nama diawali akun cPanel.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=userku_akredia
DB_USERNAME=userku_akredia
DB_PASSWORD="ganti-dengan-sandi-database"

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Hapus baris ini bila situs belum memakai HTTPS.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Email untuk pengingat tenggat dan ringkasan mingguan (cPanel › Email Accounts).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.domainanda.ac.id
MAIL_PORT=465
MAIL_USERNAME=akredia@domainanda.ac.id
MAIL_PASSWORD="ganti-dengan-sandi-email"
MAIL_FROM_ADDRESS="rekana@domainanda.co.id"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Pengaturan Rekana
# ---------------------------------------------------------------------------
# Administrator platform, dibuat saat "php artisan migrate --seed".
# Kosongkan REKANA_ADMIN_PASSWORD lagi setelah instalasi selesai.
REKANA_ADMIN_EMAIL=admin@domainanda.co.id
REKANA_ADMIN_PASSWORD="SandiSementara#2026"

# Wajibkan MFA (Google/Microsoft Authenticator) untuk pengguna owner.
REKANA_MFA_REQUIRED=false

# Ukuran maksimum unggahan dokumen rekanan, bukti PQ, dan HSE Plan (KB).
REKANA_UPLOAD_MAX_KB=20480

# Data contoh simulasi (Garudafood, MedcoEnergi, Pakuwon Jati) untuk situs demo.
# false untuk pemakaian sungguhan.
REKANA_DEMO=false
REKANA_DEMO_PASSWORD="Demo#2026rekana"
# Tampilkan tombol "Masuk sebagai tamu" (akun bersama, hanya lihat).
REKANA_DEMO_GUEST=true
